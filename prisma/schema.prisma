generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  main_admin
  hotel
  restaurant
  supplier
  service_provider
  viewer
}

enum VerificationStatus {
  not_started
  pending
  verified
  rejected
  needs_more_info
}

enum OnboardingStatus {
  not_started
  in_progress
  complete
}

enum LiveRequestStatus {
  draft
  pending_review
  approved
  rejected
  scheduled
  active
  completed
  canceled
}

enum DocumentsStatus {
  not_started
  pending
  verified
  rejected
  needs_more_info
}

enum PaymentStatus {
  placeholder
  not_required
  pending
  paid
  failed
}

enum LiveStatus {
  scheduled
  active
  replay
  expired
  completed
  canceled
}

enum PinReason {
  sponsored
  nearby
  most_watched
  featured_by_buyamia
}

enum RfqStatus {
  open
  in_review
  awarded
  closed
}

enum NegotiationStatus {
  open
  awaiting_response
  paused
  closed
}

enum RiskLevel {
  low
  medium
  high
}

enum RiskReviewStatus {
  pending
  reviewed
  escalated
  dismissed
}

enum AnalyticsEventType {
  account_created
  provider_followed
  provider_unfollowed
  watched_live
  live_viewed
  replay_viewed
  conversion_intent
  live_request_submitted
  live_request_approved
  live_request_rejected
  stream_scheduled
  replay_extended
  replay_visibility_updated
  live_pinned
  live_unpinned
  verification_submitted
  verification_reviewed
  question_answered
  live_question_submitted
  live_intent_signal
}

enum SellerApplicationStatus {
  draft
  submitted
  under_review
  needs_more_information
  approved
  rejected
}

enum BookingPushStatus {
  draft
  scheduled
  active
  paused
  expired
  archived
}

enum TastingStatus {
  draft
  scheduled
  published
  fully_booked
  completed
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  rescheduled
  completed
  cancelled
  no_show
}

enum MenuHighlightStatus {
  draft
  scheduled
  active
  expired
  archived
}

enum PinnedPlacementRequestStatus {
  draft
  submitted
  under_review
  approved
  rejected
  published
  expired
}

enum PinnedPlacementContentType {
  service
  live_stream
  replay
}

enum BotChannel {
  whatsapp
  telegram
}

enum BotConnectionStatus {
  not_connected
  connected
  pending_verification
  disabled
}

enum BotCommandStatus {
  success
  failed
  needs_confirmation
}

enum BotActionType {
  account_summary
  create_account
  schedule_live
  check_live_availability
  create_live_request
  live_status
  rfq_summary
  help
}

enum BotActionStatus {
  draft
  pending_confirmation
  completed
  failed
}

enum LivePresenterToolType {
  product_card
  limited_offer
  countdown
  poll
  question_spotlight
  applause_burst
  trust_badge
  concierge_prompt
  ambassador_challenge
  review_request
}

enum LiveToolTriggerReason {
  manual
  viewer_question
  purchase_intent
  follow
  high_engagement
  checkout_interest
}

enum LiveToolActivationStatus {
  active
  dismissed
  expired
}

enum LiveViewerSignalType {
  question
  follow
  purchase_intent
  replay_view
  checkout_click
  concierge_request
}

enum AmbassadorStatus {
  not_started
  active
  suspended
}

enum AmbassadorTier {
  starter
  trusted
  community_leader
  elite
}

enum ReferralStatus {
  invited
  signed_up
  converted
  expired
}

enum ReferralSource {
  live_share
  referral_link
  direct_invite
  community_action
}

enum RewardReason {
  referral_signup
  order_value
  live_share
  replay_share
  provider_follow
  community_engagement
}

enum CommunityShareChannel {
  copy_link
  whatsapp
  telegram
  linkedin
  email
}

enum PreferredContactMethod {
  platform
  whatsapp
  telegram
  email
}

enum BuyerIntentType {
  buy_product
  book_service
  request_quote
  arrange_delivery
  request_concierge
  ask_question
}

enum BuyerIntentUrgency {
  today
  this_week
  flexible
}

enum BuyerIntentStatus {
  captured
  qualifying
  concierge_review
  arranged
  completed
  cancelled
}

enum ConciergeRequestStatus {
  open
  in_progress
  waiting_for_buyer
  waiting_for_provider
  arranged
  completed
  cancelled
}

enum ConciergeActionType {
  contact_buyer
  contact_provider
  arrange_delivery
  arrange_booking
  request_address
  request_payment_provider
  request_insurance_provider
  complete_outcome
}

enum ConciergeActionStatus {
  pending
  completed
  blocked
}

enum OutcomeStatus {
  pending
  arranged
  fulfilled
  failed
}

enum OutcomeType {
  product_sale
  service_booking
  quote_request
  concierge_arrangement
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 Role
  verificationStatus   VerificationStatus    @default(not_started)
  onboardingStatus     OnboardingStatus      @default(in_progress)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  providerProfile      ProviderProfile?
  sessions             Session[]
  verificationRequests VerificationRequest[]
  analyticsEvents      AnalyticsEvent[]
  adminActivities      AdminActivity[]       @relation("AdminActivities")
  follows              Follow[]              @relation("ViewerFollows")
  liveToolActivations  LiveToolActivation[]  @relation("PresenterToolActivations")
  liveViewerSignals    LiveViewerSignal[]    @relation("ViewerSignals")
  ambassadorProfile    AmbassadorProfile?
  referredByAmbassador Referral[]            @relation("ReferredUser")
  communityShares      CommunityShare[]      @relation("CommunityShares")
  rfqs                 Rfq[]                 @relation("RfqCreator")
  negotiations         Negotiation[]         @relation("NegotiationCreator")
  negotiationMessages  NegotiationMessage[]  @relation("NegotiationMessageAuthor")
  riskReviews          RiskReview[]          @relation("RiskReviewReviewer")
  botChannelConnections BotChannelConnection[]
  botCommandLogs       BotCommandLog[]
  botActionRequests    BotActionRequest[]
  buyerProfile         BuyerProfile?
  buyerAddresses       BuyerAddress[]
  buyerIntents         BuyerIntent[]         @relation("BuyerIntents")
}

model BotChannelConnection {
  id               String              @id @default(cuid())
  userId           String
  channel          BotChannel
  handle           String
  phoneNumber      String?
  status           BotConnectionStatus @default(not_connected)
  providerMetadata Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

model BotCommandLog {
  id             String           @id @default(cuid())
  userId         String?
  channel        BotChannel
  rawMessage     String
  detectedIntent BotActionType
  status         BotCommandStatus
  responseText   String
  createdAt      DateTime         @default(now())
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model BotActionRequest {
  id         String          @id @default(cuid())
  userId     String
  actionType BotActionType
  payload    Json?
  status     BotActionStatus @default(draft)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  displayName     String
  category        Role
  description     String?
  location        String?
  website         String?
  completedOrders Int              @default(0)
  responseRate    Int              @default(0)
  responseMinutes Int              @default(0)
  certifications  Json?
  bImpactScore    Int              @default(0)
  certifiedReviews Int             @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveRequests    LiveRequest[]
  lives           Live[]
  bookingPushes   BookingPush[]
  reviewBriefs    ReviewBrief[]
  tastings        Tasting[]
  reservations    Reservation[]
  menuHighlights  MenuHighlight[]
  pinnedPlacementRequests PinnedPlacementRequest[]
  followers       Follow[]         @relation("ProviderFollowers")
  analyticsEvents AnalyticsEvent[]
  communityShares CommunityShare[]
  negotiations    Negotiation[]
  riskReviews     RiskReview[]
  buyerIntents     BuyerIntent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id               String             @id @default(cuid())
  userId           String
  status           VerificationStatus @default(pending)
  documentType     String
  documentMetadata Json
  reviewNote       String?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LiveRequest {
  id              String            @id @default(cuid())
  providerId      String
  title           String
  category        String
  description     String
  preferredDate   DateTime
  status          LiveRequestStatus @default(draft)
  documentsStatus DocumentsStatus   @default(not_started)
  paymentStatus   PaymentStatus     @default(placeholder)
  adminNote       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  provider        ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  live            Live?
}

model Live {
  id              String           @id @default(cuid())
  providerId      String
  liveRequestId   String?          @unique
  title           String
  category        String
  status          LiveStatus       @default(scheduled)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  replayExpiresAt DateTime?
  isPinned        Boolean          @default(false)
  pinReason       PinReason?
  pinExpiresAt    DateTime?
  priorityScore   Int              @default(0)
  viewerCount     Int              @default(0)
  replayViews     Int              @default(0)
  conversionIntent Int             @default(0)
  transcript      Json?
  specialistHost  Json?
  commerceData    Json?
  intentQuestions Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  provider        ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  liveRequest     LiveRequest?     @relation(fields: [liveRequestId], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]
  toolActivations LiveToolActivation[]
  viewerSignals   LiveViewerSignal[]
  communityShares CommunityShare[]
  buyerIntents    BuyerIntent[]
}

model BuyerProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  displayName            String
  phone                  String?
  preferredContactMethod PreferredContactMethod @default(platform)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerAddress {
  id         String        @id @default(cuid())
  userId     String
  label      String
  line1      String
  line2      String?
  city       String
  region     String?
  country    String
  postalCode String?
  isDefault  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  intents    BuyerIntent[]

  @@index([userId, isDefault])
}

model BuyerIntent {
  id                   String              @id @default(cuid())
  buyerId              String
  liveId               String?
  providerId           String?
  productOrServiceName String
  category             String
  intentType           BuyerIntentType
  quantity             Int?
  budgetLabel          String?
  urgency              BuyerIntentUrgency  @default(flexible)
  status               BuyerIntentStatus   @default(captured)
  addressId            String?
  notes                String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  buyer                User                @relation("BuyerIntents", fields: [buyerId], references: [id], onDelete: Cascade)
  live                 Live?               @relation(fields: [liveId], references: [id], onDelete: SetNull)
  provider             ProviderProfile?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  address              BuyerAddress?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  conciergeRequests    ConciergeRequest[]
  outcomes             Outcome[]

  @@index([buyerId, createdAt])
  @@index([providerId, liveId])
  @@index([status, createdAt])
}

model ConciergeRequest {
  id                String                  @id @default(cuid())
  buyerIntentId     String
  assignedAgentName String                  @default("Buyamia Concierge")
  status            ConciergeRequestStatus  @default(open)
  requestedServices Json
  conciergeNote     String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  buyerIntent       BuyerIntent             @relation(fields: [buyerIntentId], references: [id], onDelete: Cascade)
  actions           ConciergeAction[]

  @@index([status, createdAt])
  @@index([buyerIntentId])
}

model ConciergeAction {
  id                   String                 @id @default(cuid())
  conciergeRequestId   String
  actionType           ConciergeActionType
  status               ConciergeActionStatus  @default(pending)
  note                 String
  createdAt            DateTime               @default(now())
  conciergeRequest     ConciergeRequest       @relation(fields: [conciergeRequestId], references: [id], onDelete: Cascade)

  @@index([conciergeRequestId, status])
}

model Outcome {
  id            String         @id @default(cuid())
  buyerIntentId String
  status        OutcomeStatus  @default(pending)
  outcomeType   OutcomeType
  summary       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  buyerIntent   BuyerIntent    @relation(fields: [buyerIntentId], references: [id], onDelete: Cascade)

  @@index([buyerIntentId, status])
}

model AmbassadorProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  status       AmbassadorStatus   @default(not_started)
  referralCode String             @unique
  totalPoints  Int                @default(0)
  tier         AmbassadorTier     @default(starter)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals    Referral[]
  rewards      RewardLedger[]

  @@index([status, tier])
}

model Referral {
  id             String            @id @default(cuid())
  ambassadorId   String
  referredEmail  String?
  referredUserId String?
  status         ReferralStatus    @default(invited)
  source         ReferralSource    @default(referral_link)
  createdAt      DateTime          @default(now())
  convertedAt    DateTime?
  ambassador     AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  referredUser   User?             @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([ambassadorId, status, createdAt])
  @@index([referredUserId])
}

model RewardLedger {
  id             String            @id @default(cuid())
  ambassadorId   String
  points         Int
  reason         RewardReason
  sourceAmount   Float?
  sourceCurrency String?
  note           String
  createdAt      DateTime          @default(now())
  ambassador     AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId, createdAt])
  @@index([reason])
}

model CommunityShare {
  id         String                @id @default(cuid())
  userId     String
  liveId     String?
  providerId String?
  channel    CommunityShareChannel
  createdAt  DateTime              @default(now())
  user       User                  @relation("CommunityShares", fields: [userId], references: [id], onDelete: Cascade)
  live       Live?                 @relation(fields: [liveId], references: [id], onDelete: SetNull)
  provider   ProviderProfile?      @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([liveId, createdAt])
  @@index([providerId, createdAt])
}

model LivePresenterTool {
  id             String                @id @default(cuid())
  name           String
  type           LivePresenterToolType @unique
  description    String
  defaultPayload Json
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model LiveToolActivation {
  id            String                   @id @default(cuid())
  liveId        String
  presenterId   String
  toolType      LivePresenterToolType
  payload       Json
  triggerReason LiveToolTriggerReason    @default(manual)
  status        LiveToolActivationStatus @default(active)
  createdAt     DateTime                 @default(now())
  expiresAt     DateTime?
  live          Live                     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  presenter     User                     @relation("PresenterToolActivations", fields: [presenterId], references: [id], onDelete: Cascade)

  @@index([liveId, status, createdAt])
  @@index([presenterId])
}

model LiveViewerSignal {
  id         String               @id @default(cuid())
  liveId     String
  viewerId   String?
  signalType LiveViewerSignalType
  payload    Json
  createdAt  DateTime             @default(now())
  live       Live                 @relation(fields: [liveId], references: [id], onDelete: Cascade)
  viewer     User?                @relation("ViewerSignals", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([liveId, signalType, createdAt])
  @@index([viewerId])
}

model Follow {
  id         String          @id @default(cuid())
  viewerId   String
  providerId String
  createdAt  DateTime        @default(now())
  viewer     User            @relation("ViewerFollows", fields: [viewerId], references: [id], onDelete: Cascade)
  provider   ProviderProfile @relation("ProviderFollowers", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, providerId])
}

model AnalyticsEvent {
  id               String           @id @default(cuid())
  userId           String?
  providerId       String?
  liveId           String?
  eventType        String
  conversionSource String?
  conversionIntent String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  live             Live?            @relation(fields: [liveId], references: [id], onDelete: SetNull)
}

model AdminActivity {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  message    String
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActivities", fields: [adminId], references: [id], onDelete: Cascade)
}

model Rfq {
  id            String        @id @default(cuid())
  adminId       String?
  title         String
  category      String
  requirements  String
  budgetMin     Float?
  budgetMax     Float?
  deadline      DateTime
  supplierType  Role?
  status        RfqStatus     @default(open)
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation("RfqCreator", fields: [createdById], references: [id], onDelete: Cascade)
  negotiations  Negotiation[]
  riskReviews   RiskReview[]
}

model Negotiation {
  id          String               @id @default(cuid())
  adminId     String?
  title       String
  status      NegotiationStatus    @default(open)
  providerId  String?
  rfqId       String?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  provider    ProviderProfile?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  rfq         Rfq?                 @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("NegotiationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    NegotiationMessage[]
}

model NegotiationMessage {
  id            String       @id @default(cuid())
  negotiationId String
  authorId      String
  body          String
  message       String?
  createdAt     DateTime     @default(now())
  negotiation   Negotiation  @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  author        User         @relation("NegotiationMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model RiskReview {
  id           String           @id @default(cuid())
  adminId      String?
  targetType   String
  providerId   String?
  rfqId        String?
  riskLevel    RiskLevel
  indicators   Json
  reviewStatus RiskReviewStatus @default(pending)
  status       RiskReviewStatus?
  adminNote    String?
  note         String?
  reviewerId   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  provider     ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  rfq          Rfq?             @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  reviewer     User?            @relation("RiskReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
}

model SellerApplication {
  id                       String                  @id @default(cuid())
  status                   SellerApplicationStatus @default(submitted)
  businessName             String
  businessType             Role
  country                  String
  contactPerson            String
  businessEmail            String
  phoneNumber              String
  companyDescription       String
  categories               Json
  productsOrServices       String
  website                  String?
  verificationDocuments    Json
  submittedAt              DateTime?
  reviewedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

model AiSourcingRequest {
  id                        String   @id @default(cuid())
  productDescription        String
  productCategory           String
  quantity                  Int
  targetCountry             String
  preferredSupplierLocation String?
  budget                    Float?
  moqPreference             String
  deliveryDeadline          DateTime
  additionalRequirements    String?
  recommendations           Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model BookingPush {
  id                   String            @id @default(cuid())
  providerId           String
  status               BookingPushStatus @default(scheduled)
  campaignTitle        String
  hotelName            String
  promotionDescription String
  roomType             String
  bookingOffer         String
  discountPercentage   Int?
  startDate            DateTime
  endDate              DateTime
  availableRooms       Int
  targetAudience       String
  featuredImageUrl     String?
  callToActionText     String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  provider             ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ReviewBrief {
  id             String          @id @default(cuid())
  providerId     String
  reviewPeriod   String
  reviewSource   String
  language       String
  report         Json
  generatedAt    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Tasting {
  id                  String          @id @default(cuid())
  providerId          String
  status              TastingStatus   @default(scheduled)
  title               String
  restaurantName      String
  description         String
  cuisineCategory     String
  tastingType         String
  scheduledAt         DateTime
  durationMinutes     Int
  maxParticipants     Int
  price               Int?
  location            String
  featuredImageUrl    String?
  additionalNotes     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  provider            ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Reservation {
  id               String            @id @default(cuid())
  providerId       String
  customerName     String
  reservationAt    DateTime
  partySize        Int
  status           ReservationStatus @default(pending)
  bookingReference String            @unique
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  provider         ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model MenuHighlight {
  id                 String              @id @default(cuid())
  providerId         String
  dishName           String
  category           String
  shortDescription   String
  price              Int
  availabilityStatus String
  featuredImageUrl   String?
  featuredBadge      String?
  priorityLevel      Int
  startDate          DateTime
  endDate            DateTime
  visibilityStatus   String
  isPinned           Boolean             @default(false)
  status             MenuHighlightStatus @default(scheduled)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model PinnedPlacementRequest {
  id                 String                       @id @default(cuid())
  providerId         String
  contentType        PinnedPlacementContentType
  contentId          String
  promotionTitle     String
  reason             String
  promotionPeriod    String
  preferredStartDate DateTime
  preferredEndDate   DateTime
  targetAudience     String
  additionalNotes    String?
  status             PinnedPlacementRequestStatus @default(submitted)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  provider           ProviderProfile              @relation(fields: [providerId], references: [id], onDelete: Cascade)
}
